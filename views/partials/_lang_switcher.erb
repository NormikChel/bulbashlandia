<div class="switcher lang-switcher" data-open="false">
  <button type="button"
          class="btn-icon switcher-toggle"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="<%= h(@t.dig('lang', 'label')) %>"
          title="<%= h(@t.dig('lang', 'label')) %>"
          data-lang-code="<%= @locale %>"></button>

  <ul class="switcher-menu" role="menu" aria-label="<%= h(@t.dig('lang', 'choose')) %>">
    <li class="lang-item <%= 'is-active' if @locale == 'ru' %>">
      <a href="/ru" role="menuitem" hreflang="ru"
         class="lang-name"
         aria-label="<%= h(@t.dig('lang', 'ru')) %>"
         data-flag="🇷🇺"
         data-label="<%= h(@t.dig('lang', 'ru')) %>"></a>
    </li>

    <li class="lang-item lang-item-be <%= 'is-active' if ['be', 'be-latn'].include?(@locale) %>">
      <a href="/be" role="menuitem" hreflang="be"
         class="lang-name"
         aria-label="<%= h(@t.dig('lang', 'be')) %>"
         data-flag="🇧🇾"
         data-label="<%= h(@t.dig('lang', 'be')) %>"></a>

      <span class="script-switch" role="group" aria-label="<%= h(@t.dig('lang', 'choose')) %>">
        <a href="/be" hreflang="be"
           class="script <%= 'is-active' if @locale == 'be' %>"
           aria-label="<%= h(@t.dig('lang', 'be_cyr_title')) %>"
           title="<%= h(@t.dig('lang', 'be_cyr_title')) %>"
           data-script="К"></a>
        <a href="/be-latn" hreflang="be-latn"
           class="script <%= 'is-active' if @locale == 'be-latn' %>"
           aria-label="<%= h(@t.dig('lang', 'be_latn_title')) %>"
           title="<%= h(@t.dig('lang', 'be_latn_title')) %>"
           data-script="Ł"></a>
      </span>
    </li>

    <li class="lang-item <%= 'is-active' if @locale == 'en' %>">
      <a href="/en" role="menuitem" hreflang="en"
         class="lang-name"
         aria-label="<%= h(@t.dig('lang', 'en')) %>"
         data-flag="🇬🇧"
         data-label="<%= h(@t.dig('lang', 'en')) %>"></a>
    </li>

    <li class="lang-item <%= 'is-active' if @locale == 'uk' %>">
      <a href="/uk" role="menuitem" hreflang="uk"
         class="lang-name"
         aria-label="<%= h(@t.dig('lang', 'uk')) %>"
         data-flag="🇺🇦"
         data-label="<%= h(@t.dig('lang', 'uk')) %>"></a>
    </li>
  </ul>
</div>