<div class="switcher theme-switcher" data-open="false">
  <button type="button" class="btn-icon switcher-toggle" aria-haspopup="true" aria-expanded="false" aria-label="<%= @t['theme']['label'] %>" title="<%= @t['theme']['label'] %>">
    <svg class="icon-theme" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="5"/>
      <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
    </svg>
  </button>

  <ul class="switcher-menu" role="menu">
    <li><button type="button" role="menuitem" data-theme-mode="system"><span aria-hidden="true">🖥</span> <%= @t['theme']['system'] %></button></li>
    <li><button type="button" role="menuitem" data-theme-mode="light"><span aria-hidden="true">☀️</span> <%= @t['theme']['light'] %></button></li>
    <li><button type="button" role="menuitem" data-theme-mode="dark"><span aria-hidden="true">🌙</span> <%= @t['theme']['dark'] %></button></li>
  </ul>
</div>