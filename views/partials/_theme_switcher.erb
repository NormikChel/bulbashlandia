<div class="theme-switcher">
  <button class="theme-toggle btn-icon" aria-label="<%= @t['theme']['label'] %>" data-mode="system">◐</button>
  <ul class="theme-menu">
    <li><button data-theme-mode="system"><%= @t['theme']['system'] %></button></li>
    <li><button data-theme-mode="light"><%= @t['theme']['light'] %></button></li>
    <li><button data-theme-mode="dark"><%= @t['theme']['dark'] %></button></li>
  </ul>
</div>