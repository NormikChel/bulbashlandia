<header class="page-header">
  <h1><%= h(@t.dig('nav', 'history')) %></h1>
</header>

<div class="cities-grid">
  <% @articles.each do |article| %>
    <a class="card" href="<%= l("/articles/#{article.slug}") %>">
      <h2><%= h(article.localized_title(@locale)) %></h2>
      <p class="region"><%= h(article.category) %></p>
      <p class="excerpt"><%= h(article.localized_excerpt(@locale)) %></p>
    </a>
  <% end %>
</div>