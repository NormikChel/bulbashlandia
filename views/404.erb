<section class="error-page" aria-labelledby="error-title">
  <div class="error-code" aria-hidden="true">404</div>

  <h1 id="error-title" class="error-title">
    <%= h(@t.dig('errors', 'not_found_title')) %>
  </h1>

  <p class="error-text">
    <%= h(@t.dig('errors', 'not_found_text')) %>
  </p>

  <div class="error-actions">
    <a class="btn btn-primary" href="<%= l('/') %>">
      <%= h(@t.dig('errors', 'back_home')) %>
    </a>
    <a class="btn btn-secondary" href="<%= l('/cities') %>">
      <%= h(@t.dig('nav', 'cities')) %>
    </a>
  </div>
</section>