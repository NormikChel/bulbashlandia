<article class="city-page">
  <nav class="breadcrumbs" aria-label="Breadcrumbs">
    <a href="<%= l('/') %>"><%= h(@t.dig('breadcrumbs', 'home')) %></a>
    <span aria-hidden="true"><%= h(@t.dig('breadcrumbs', 'separator')) %></span>
    <a href="<%= l('/cities') %>"><%= h(@t.dig('nav', 'cities')) %></a>
    <span aria-hidden="true"><%= h(@t.dig('breadcrumbs', 'separator')) %></span>
    <span aria-current="page"><%= h(@city.localized_name(@locale)) %></span>
  </nav>

  <header class="page-header">
    <h1><%= h(@city.localized_name(@locale)) %></h1>
    <p class="lead"><%= h(@city.localized_region(@locale)) %></p>
  </header>

  <% if @city.photo_url && !@city.photo_url.empty? %>
    <figure class="city-photo">
      <img src="<%= h(@city.photo_url) %>" alt="<%= h(@city.localized_name(@locale)) %>">
    </figure>
  <% end %>

  <section class="city-description">
    <p><%= h(@city.localized_description(@locale)) %></p>
  </section>

  <aside class="city-facts">
    <h2><%= h(@t.dig('city', 'history')) %></h2>
    <dl>
      <% if @city.population %>
        <dt><%= h(@t.dig('city', 'population')) %></dt>
        <dd><%= @city.formatted_population %></dd>
      <% end %>
      <% if @city.founded %>
        <dt><%= h(@t.dig('city', 'founded')) %></dt>
        <dd><%= @city.founded %></dd>
      <% end %>
      <% if @city.area %>
        <dt><%= h(@t.dig('city', 'area')) %></dt>
        <dd><%= @city.area %> км²</dd>
      <% end %>
      <dt><%= h(@t.dig('city', 'region')) %></dt>
      <dd><%= h(@city.localized_region(@locale)) %></dd>
    </dl>
  </aside>

  <p class="back">
    <a href="<%= l('/cities') %>"><%= h(@t.dig('cities', 'back_to_list')) %></a>
  </p>
</article>