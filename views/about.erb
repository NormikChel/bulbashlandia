<article class="about-page">
  <h1 class="about-title"><%= h(@t.dig('about', 'title')) %></h1>

  <p class="about-lead"><%= h(@t.dig('about', 'intro')) %></p>
  <p class="about-lead"><%= h(@t.dig('about', 'mission')) %></p>

  <section class="about-section">
    <h2><%= h(@t.dig('about', 'what_title')) %></h2>
    <ul>
      <li><strong><%= h(@t.dig('sections', 'cities_title')) %></strong> — <%= h(@t.dig('sections', 'cities_subtitle')) %></li>
      <li><strong><%= h(@t.dig('sections', 'history_title')) %></strong> — <%= h(@t.dig('sections', 'history_subtitle')) %></li>
      <li><strong><%= h(@t.dig('sections', 'culture_title')) %></strong> — <%= h(@t.dig('sections', 'culture_subtitle')) %></li>
      <li><strong><%= h(@t.dig('sections', 'cuisine_title')) %></strong> — <%= h(@t.dig('sections', 'cuisine_subtitle')) %></li>
      <li><strong><%= h(@t.dig('sections', 'nature_title')) %></strong> — <%= h(@t.dig('sections', 'nature_subtitle')) %></li>
    </ul>
  </section>

  <section class="about-section">
    <h2><%= h(@t.dig('about', 'tech_title')) %></h2>
    <p><%= h(@t.dig('about', 'tech_body')) %></p>
  </section>

  <section class="about-section">
    <h2><%= h(@t.dig('about', 'contacts_title')) %></h2>
    <p><%= h(@t.dig('about', 'contacts_text')) %></p>
    <p>
      <a class="btn" href="mailto:hello@bulbashlandia.example">
        <%= h(@t.dig('about', 'feedback')) %>
      </a>
    </p>
  </section>

  <p class="about-license"><%= h(@t.dig('about', 'license')) %></p>
</article>