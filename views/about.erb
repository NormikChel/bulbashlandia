<article class="about-page">
  <header class="page-header">
    <h1><%= @t['about']['title'] %></h1>
    <p class="lead"><%= @t['about']['intro'] %></p>
  </header>

  <section class="about-mission">
    <h2><%= @t['about']['mission'] %></h2>
    <p>
      <%= @t['about']['mission'] %>
    </p>
  </section>

  <section class="about-contacts">
    <h2><%= @t['about']['contacts_title'] %></h2>
    <p><%= @t['about']['contacts_text'] %></p>
    <a class="btn btn-primary" href="mailto:hello@bulbashlandia.example"><%= @t['about']['feedback'] %></a>
  </section>

  <section class="about-license">
    <h2><%= @t['legal']['privacy_title'] %></h2>
    <p><%= @t['about']['license'] %></p>
  </section>
</article>